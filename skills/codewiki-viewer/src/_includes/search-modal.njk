<!-- Search Modal -->
<div id="search-modal" class="fixed inset-0 z-[60] hidden">
    <div class="search-overlay absolute inset-0 bg-black/40" onclick="closeSearch()"></div>
    <div class="relative mx-auto mt-[10vh] w-full max-w-2xl bg-white dark:bg-gray-900 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 fade-in overflow-hidden">
        <div class="flex items-center border-b border-gray-200 dark:border-gray-700 px-4">
            <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input id="search-input" type="text" placeholder="Search documentation..."
                   class="w-full px-3 py-4 text-base outline-none bg-transparent dark:text-gray-100"
                   oninput="onSearchInput(this.value)"
                   onkeydown="onSearchKeydown(event)" />
            <kbd class="text-xs text-gray-400 bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded border border-gray-200 dark:border-gray-600 cursor-pointer" onclick="closeSearch()">ESC</kbd>
        </div>
        <div id="search-results" class="max-h-[60vh] overflow-y-auto">
            <div id="search-empty" class="py-12 text-center text-gray-400 dark:text-gray-500 text-sm">
                <svg class="w-10 h-10 mx-auto mb-3 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                Type to search across all pages
            </div>
            <ul id="search-list" class="divide-y divide-gray-100 dark:divide-gray-800"></ul>
        </div>
        <div class="flex items-center gap-4 px-4 py-2.5 border-t border-gray-100 dark:border-gray-800 text-xs text-gray-400 bg-gray-50 dark:bg-gray-900/80">
            <span class="flex items-center gap-1"><kbd class="px-1 py-0.5 bg-white dark:bg-gray-800 rounded border border-gray-200 dark:border-gray-600">↑↓</kbd> Navigate</span>
            <span class="flex items-center gap-1"><kbd class="px-1 py-0.5 bg-white dark:bg-gray-800 rounded border border-gray-200 dark:border-gray-600">↵</kbd> Open</span>
            <span class="flex items-center gap-1"><kbd class="px-1 py-0.5 bg-white dark:bg-gray-800 rounded border border-gray-200 dark:border-gray-600">esc</kbd> Close</span>
        </div>
    </div>
</div>

<!-- Search Data & Logic -->
<script>
const SEARCH_DATA = [
    {% for page in collections.wikiPages %}
    {
        title: {{ page.data.title | jsonStringify | safe }},
        url: {{ page.url | jsonStringify | safe }},
        headings: [{% for h in page.templateContent | extractHeadings %}{{ h.text | jsonStringify | safe }}{% if not loop.last %},{% endif %}{% endfor %}],
        text: {{ page.templateContent | striptags | jsonStringify | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
];

let _tokenIndex = null;
let searchSelectedIdx = 0;
let searchResults = [];

function buildTokenIndex() {
    if (_tokenIndex) return _tokenIndex;
    const idx = {};
    SEARCH_DATA.forEach((entry, i) => {
        const text = (entry.title + ' ' + entry.headings.join(' ') + ' ' + entry.text).toLowerCase();
        const tokens = text.split(/\W+/).filter(t => t.length > 1);
        [...new Set(tokens)].forEach(token => {
            if (!idx[token]) idx[token] = [];
            idx[token].push(i);
        });
    });
    _tokenIndex = idx;
    return idx;
}

function searchQuery(query) {
    if (!query || query.trim().length < 2) return [];
    const q = query.toLowerCase().trim();
    const qTokens = q.split(/\W+/).filter(t => t.length > 1);
    if (!qTokens.length) return [];

    const idx = buildTokenIndex();
    const scores = {};

    qTokens.forEach(qt => {
        Object.keys(idx).forEach(token => {
            if (token.startsWith(qt) || token.includes(qt)) {
                const boost = token === qt ? 3 : (token.startsWith(qt) ? 2 : 1);
                idx[token].forEach(di => { scores[di] = (scores[di] || 0) + boost; });
            }
        });
    });

    SEARCH_DATA.forEach((entry, i) => {
        if (entry.title.toLowerCase().includes(q)) scores[i] = (scores[i] || 0) + 10;
        entry.headings.forEach(h => {
            if (h.toLowerCase().includes(q)) scores[i] = (scores[i] || 0) + 5;
        });
    });

    return Object.entries(scores)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 15)
        .map(([di]) => {
            const entry = SEARCH_DATA[di];
            const text = entry.text;
            const pos = text.toLowerCase().indexOf(q);
            let snippet = '';
            if (pos >= 0) {
                const s = Math.max(0, pos - 60), e = Math.min(text.length, pos + q.length + 80);
                snippet = (s > 0 ? '...' : '') + text.slice(s, e) + (e < text.length ? '...' : '');
            } else {
                snippet = text.slice(0, 140) + (text.length > 140 ? '...' : '');
            }
            const re = new RegExp('(' + qTokens.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')', 'gi');
            const escDiv = document.createElement('div');
            escDiv.textContent = snippet;
            snippet = escDiv.innerHTML.replace(re, '<mark>$1</mark>');

            return {
                url: entry.url,
                title: entry.title,
                snippet,
                matchedHeadings: entry.headings.filter(h => h.toLowerCase().includes(q)).slice(0, 3),
            };
        });
}

function onSearchInput(value) {
    searchResults = searchQuery(value);
    searchSelectedIdx = 0;
    renderSearchResults(value);
}

function renderSearchResults(query) {
    const list = document.getElementById('search-list');
    const empty = document.getElementById('search-empty');

    if (!query || query.trim().length < 2) {
        list.innerHTML = '';
        empty.style.display = 'block';
        return;
    }
    if (!searchResults.length) {
        list.innerHTML = '';
        empty.style.display = 'block';
        const escDiv = document.createElement('div');
        escDiv.textContent = query;
        empty.innerHTML = '<svg class="w-10 h-10 mx-auto mb-3 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M12 20a8 8 0 100-16 8 8 0 000 16z"/></svg>No results for "' + escDiv.innerHTML + '"';
        return;
    }
    empty.style.display = 'none';
    list.innerHTML = searchResults.map((r, i) => {
        const escDiv = document.createElement('div');
        escDiv.textContent = r.title;
        const safeTitle = escDiv.innerHTML;
        const headingHtml = r.matchedHeadings.map(h => {
            const d = document.createElement('div'); d.textContent = h;
            return '<span class="text-xs bg-indigo-100 dark:bg-indigo-900 text-indigo-700 dark:text-indigo-300 px-1.5 py-0.5 rounded">' + d.innerHTML + '</span>';
        }).join('');
        return '<li><a href="' + r.url + '" class="block px-4 py-3 hover:bg-indigo-50 dark:hover:bg-indigo-950 transition-colors ' + (i === searchSelectedIdx ? 'bg-indigo-50 dark:bg-indigo-950' : '') + '">'
            + '<div class="flex items-center gap-2 mb-1"><svg class="w-4 h-4 text-indigo-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>'
            + '<span class="font-medium text-sm text-gray-900 dark:text-gray-100">' + safeTitle + '</span></div>'
            + (headingHtml ? '<div class="ml-6 mb-1 flex flex-wrap gap-1">' + headingHtml + '</div>' : '')
            + '<p class="ml-6 text-xs text-gray-500 dark:text-gray-400 line-clamp-2 leading-relaxed">' + r.snippet + '</p>'
            + '</a></li>';
    }).join('');
}

function onSearchKeydown(e) {
    if (e.key === 'ArrowDown') { e.preventDefault(); searchSelectedIdx = Math.min(searchSelectedIdx + 1, searchResults.length - 1); renderSearchResults(document.getElementById('search-input').value); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); searchSelectedIdx = Math.max(searchSelectedIdx - 1, 0); renderSearchResults(document.getElementById('search-input').value); }
    else if (e.key === 'Enter' && searchResults.length) { e.preventDefault(); window.location.href = searchResults[searchSelectedIdx].url; closeSearch(); }
    else if (e.key === 'Escape') { closeSearch(); }
}

function openSearch() {
    document.getElementById('search-modal').classList.remove('hidden');
    const input = document.getElementById('search-input');
    input.value = '';
    input.focus();
    onSearchInput('');
    document.body.style.overflow = 'hidden';
}

function closeSearch() {
    document.getElementById('search-modal').classList.add('hidden');
    document.body.style.overflow = '';
}
</script>
