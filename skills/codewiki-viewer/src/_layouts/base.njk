<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} — CodeWiki</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 50: '#eef2ff', 100: '#e0e7ff', 500: '#6366f1', 600: '#4f46e5', 700: '#4338ca', 800: '#3730a3' }
                    }
                }
            }
        };
    </script>

    <!-- Mermaid -->
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>

    <!-- Prism.js for syntax highlighting -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css">
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>

    <style>
        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }

        /* ── Sidebar ── */
        .sidebar-link { transition: all 0.15s ease; }
        .sidebar-link:hover { background: #f1f5f9; }
        .dark .sidebar-link:hover { background: #1e293b; }
        .sidebar-link.active { background: #eef2ff; color: #4f46e5; border-right: 3px solid #6366f1; }
        .dark .sidebar-link.active { background: #1e1b4b; color: #a5b4fc; border-right-color: #818cf8; }

        /* ── Search ── */
        mark { background: #fef08a; padding: 0 2px; border-radius: 2px; }
        .dark mark { background: #854d0e; color: #fef9c3; }
        .search-overlay { backdrop-filter: blur(4px); }

        /* ── Animations ── */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
        .fade-in { animation: fadeIn 0.2s ease-out; }

        /* ── Mobile sidebar ── */
        @media (max-width: 1023px) {
            .sidebar-panel { transform: translateX(-100%); transition: transform 0.3s ease; }
            .sidebar-panel.open { transform: translateX(0); }
        }

        /* ── Code blocks ── */
        .code-block-wrapper {
            position: relative;
            margin-bottom: 1.5rem;
        }
        .code-lang-label {
            position: absolute;
            top: 0.5rem;
            right: 0.75rem;
            font-size: 0.7rem;
            color: #9ca3af;
            font-family: ui-monospace, monospace;
            z-index: 1;
            pointer-events: none;
        }
        .code-block {
            background: #1e1e2e;
            border-radius: 0.5rem;
            padding: 1rem 1.25rem;
            overflow-x: auto;
            font-size: 0.85rem;
            line-height: 1.6;
        }
        .code-block code {
            font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
            color: #e2e8f0;
        }

        /* ── Mermaid ── */
        .mermaid-wrapper { display: flex; justify-content: center; overflow-x: auto; }
        .mermaid-wrapper svg { max-width: 100%; height: auto; }

        /* ── Mermaid fullscreen ── */
        .mermaid-fullscreen-overlay { backdrop-filter: blur(6px); }
        .mermaid-fullscreen-content { animation: fadeIn 0.2s ease-out; }
        .mermaid-fullscreen-content svg { max-width: 95vw; max-height: 85vh; width: auto; height: auto; }
        .mermaid-fullscreen-content .mermaid { display: flex; justify-content: center; align-items: center; }

        /* ── TOC ── */
        .toc-link { transition: color 0.15s ease; }
        .toc-link:hover { color: #4f46e5; }
        .dark .toc-link:hover { color: #a5b4fc; }

        /* ── Print ── */
        @media print {
            .sidebar-panel, .top-header, .search-btn, .theme-toggle, #toc-rail { display: none !important; }
            .main-content { margin-left: 0 !important; }
        }

        /* ── Prose content ── */
        .wiki-content h1 { font-size: 1.875rem; font-weight: 700; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid #e5e7eb; }
        .wiki-content h2 { font-size: 1.5rem; font-weight: 700; margin-top: 2.5rem; margin-bottom: 1rem; }
        .wiki-content h3 { font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; }
        .wiki-content h4 { font-size: 1.125rem; font-weight: 600; margin-top: 1.5rem; margin-bottom: 0.5rem; }
        .wiki-content p { margin-bottom: 1rem; line-height: 1.75; }
        .wiki-content ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1rem; }
        .wiki-content ol { list-style: decimal; padding-left: 1.5rem; margin-bottom: 1rem; }
        .wiki-content li { margin-bottom: 0.25rem; line-height: 1.7; }
        .wiki-content blockquote { border-left: 4px solid #a5b4fc; padding: 0.5rem 1rem; margin: 1rem 0; background: #eef2ff; border-radius: 0 0.375rem 0.375rem 0; }
        .dark .wiki-content blockquote { background: #1e1b4b; border-left-color: #6366f1; }
        .wiki-content table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
        .wiki-content th { background: #f8fafc; padding: 0.625rem 1rem; text-align: left; font-weight: 600; border: 1px solid #e2e8f0; }
        .wiki-content td { padding: 0.625rem 1rem; border: 1px solid #e2e8f0; }
        .dark .wiki-content th { background: #1e293b; border-color: #334155; }
        .dark .wiki-content td { border-color: #334155; }
        .wiki-content a { color: #4f46e5; text-decoration: underline; }
        .wiki-content a:hover { color: #3730a3; }
        .dark .wiki-content a { color: #a5b4fc; }
        .wiki-content code:not([class*="language-"]) {
            background: #f1f5f9; color: #4f46e5; padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.85em;
            font-family: ui-monospace, monospace;
        }
        .dark .wiki-content code:not([class*="language-"]) { background: #1e293b; color: #a5b4fc; }
        .wiki-content hr { border: none; border-top: 1px solid #e5e7eb; margin: 2rem 0; }
        .dark .wiki-content hr { border-top-color: #334155; }
        .dark .wiki-content h1 { border-bottom-color: #334155; }

        /* ── Dark mode prose colors ── */
        .dark .wiki-content h1, .dark .wiki-content h2, .dark .wiki-content h3, .dark .wiki-content h4 { color: #f1f5f9; }
        .dark .wiki-content p, .dark .wiki-content li { color: #cbd5e1; }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 antialiased">

    {% include "header.njk" %}
    {% include "sidebar.njk" %}

    <!-- Main Content -->
    <main class="main-content lg:ml-72 pt-14 min-h-screen">
        <div class="max-w-4xl mx-auto px-6 py-8 lg:px-10">
            <article class="wiki-content fade-in">
                {{ content | safe }}
            </article>

            <!-- Prev / Next Navigation -->
            {% set allPages = collections.wikiPages %}
            {% set currentIndex = -1 %}
            {% for p in allPages %}
                {% if p.url == page.url %}
                    {% set currentIndex = loop.index0 %}
                {% endif %}
            {% endfor %}
            {% if currentIndex >= 0 %}
            <nav class="flex items-center justify-between mt-12 pt-6 border-t border-gray-200 dark:border-gray-800">
                {% if currentIndex > 0 %}
                    {% set prev = allPages[currentIndex - 1] %}
                    <a href="{{ prev.url }}" class="group flex items-center gap-2 text-sm text-gray-500 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                        <span>{{ prev.data.title }}</span>
                    </a>
                {% else %}
                    <div></div>
                {% endif %}
                {% if currentIndex < allPages.length - 1 %}
                    {% set next = allPages[currentIndex + 1] %}
                    <a href="{{ next.url }}" class="group flex items-center gap-2 text-sm text-gray-500 hover:text-brand-600 dark:hover:text-brand-400 transition-colors ml-auto">
                        <span>{{ next.data.title }}</span>
                        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                {% endif %}
            </nav>
            {% endif %}
        </div>
    </main>

    <!-- TOC Rail (desktop) -->
    <aside id="toc-rail" class="hidden xl:block fixed top-14 right-0 w-56 h-[calc(100vh-3.5rem)] overflow-y-auto py-6 px-4">
        <div class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-3">On this page</div>
        <nav id="toc-nav" class="space-y-1 text-sm">
            {% set headings = content | extractHeadings %}
            {% for h in headings %}
                <a href="#{{ h.id }}" class="toc-link block py-1 text-gray-500 dark:text-gray-400 truncate" style="padding-left: {{ (h.level - 2) * 12 }}px">{{ h.text }}</a>
            {% endfor %}
        </nav>
    </aside>

    <!-- Mermaid Fullscreen Modal -->
    <div id="mermaid-fullscreen" class="fixed inset-0 z-[55] hidden">
        <div class="mermaid-fullscreen-overlay absolute inset-0 bg-black/50 dark:bg-black/70" onclick="closeMermaidFullscreen()"></div>
        <div class="mermaid-fullscreen-content relative flex items-center justify-center w-full h-full p-8">
            <button onclick="closeMermaidFullscreen()" class="absolute top-4 right-4 z-10 p-2 rounded-lg bg-white/90 dark:bg-gray-800/90 border border-gray-200 dark:border-gray-600 text-gray-500 hover:text-red-500 transition-colors shadow-md" title="Close (Esc)">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <div id="mermaid-fullscreen-container" class="bg-white dark:bg-gray-900 rounded-xl shadow-2xl p-8 overflow-auto max-w-[95vw] max-h-[90vh]"></div>
        </div>
    </div>

    {% include "search-modal.njk" %}

    <script>
        // ── Dark mode ──
        (function() {
            const html = document.documentElement;
            const key = 'codewiki-theme';
            const stored = localStorage.getItem(key);
            if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                html.classList.replace('light', 'dark');
            }
            window.toggleTheme = function() {
                const isDark = html.classList.contains('dark');
                html.classList.replace(isDark ? 'dark' : 'light', isDark ? 'light' : 'dark');
                localStorage.setItem(key, isDark ? 'light' : 'dark');
                updateThemeIcon();
                // Re-init mermaid for theme
                initMermaid();
            };
            window.updateThemeIcon = function() {
                const isDark = html.classList.contains('dark');
                document.getElementById('theme-icon-sun').classList.toggle('hidden', !isDark);
                document.getElementById('theme-icon-moon').classList.toggle('hidden', isDark);
            };
            document.addEventListener('DOMContentLoaded', updateThemeIcon);
        })();

        // ── Mermaid ──
        function initMermaid() {
            const isDark = document.documentElement.classList.contains('dark');
            mermaid.initialize({
                startOnLoad: false,
                theme: isDark ? 'dark' : 'default',
                securityLevel: 'loose',
                flowchart: { useMaxWidth: true, htmlLabels: true },
                sequence: { useMaxWidth: true },
                themeVariables: isDark ? {} : {
                    primaryColor: '#eef2ff',
                    primaryTextColor: '#1e1b4b',
                    primaryBorderColor: '#6366f1',
                    lineColor: '#94a3b8',
                    secondaryColor: '#f1f5f9',
                    tertiaryColor: '#faf5ff',
                }
            });
            // Re-render all mermaid diagrams
            document.querySelectorAll('.mermaid[data-processed]').forEach(el => {
                el.removeAttribute('data-processed');
                el.innerHTML = el.getAttribute('data-original') || el.textContent;
            });
            mermaid.run({ querySelector: '.mermaid' });
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Store original mermaid content for theme switches
            document.querySelectorAll('.mermaid').forEach(el => {
                el.setAttribute('data-original', el.textContent);
            });
            initMermaid();

            // Syntax highlighting
            if (window.Prism) {
                Prism.highlightAll();
            }

            // Active sidebar link
            const current = window.location.pathname;
            document.querySelectorAll('.sidebar-link').forEach(el => {
                if (el.getAttribute('href') === current) {
                    el.classList.add('active');
                }
            });
        });

        // ── Mobile sidebar ──
        document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebar-overlay').classList.toggle('hidden');
        });
        window.closeSidebar = function() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebar-overlay').classList.add('hidden');
        };

        // ── Mermaid fullscreen ──
        window.openMermaidFullscreen = function(btn) {
            const wrapper = btn.closest('.mermaid-wrapper');
            const svg = wrapper.querySelector('.mermaid svg');
            if (!svg) return;

            const container = document.getElementById('mermaid-fullscreen-container');
            container.innerHTML = '';
            const clone = svg.cloneNode(true);
            // Set explicit dimensions from viewBox for fullscreen display
            const viewBox = clone.getAttribute('viewBox');
            if (viewBox) {
                const [, , vbWidth, vbHeight] = viewBox.split(/\s+/).map(Number);
                clone.removeAttribute('width');
                clone.removeAttribute('height');
                clone.style.width = vbWidth + 'px';
                clone.style.height = vbHeight + 'px';
                clone.style.maxWidth = '95vw';
                clone.style.maxHeight = '85vh';
            }
            container.appendChild(clone);

            document.getElementById('mermaid-fullscreen').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        };

        window.closeMermaidFullscreen = function() {
            document.getElementById('mermaid-fullscreen').classList.add('hidden');
            document.body.style.overflow = '';
        };

        // ── Keyboard shortcuts ──
        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                openSearch();
            }
            if (e.key === 'Escape') {
                closeMermaidFullscreen();
                closeSearch();
            }
        });
    </script>
</body>
</html>
